{
  "_说明": "正式实验配置：对比对象 = UT（斜方肌上束）vs ECU（桡侧腕伸肌），判据 = APDF 的 median 水平（P50，即 P=0.5）做实时比较。比较窗/基线/比较间隔均 900 s，确认 30 s，切换渐变 300 s。MVC 请按你实测计算出的数值在统一界面输入框里填入（界面会覆盖这里的初值）。dry_run 只是默认值，真正写鼠标需在界面勾选「★ 真实写 Raw Accel」并确认。三个 APDF 水平仍全部记录与输出（static P10 / median P50 / peak P90），只是**切换决策只看 P50**。",

  "plugin_dir": "plugin",

  "channels": "A1=ECU,A3=UT",
  "mvc": {"ECU": 80.0, "UT": 83.0},

  "pair": ["UT", "ECU"],
  "metric": "apdf_level",
  "level_percentile": 50.0,
  "direction": {"ECU": "up", "UT": "up"},
  "high_thr": 20.0,
  "roll_window_sec": 900.0,
  "baseline_sec": 900.0,
  "deadband": 0.15,
  "deadband_abs_mvc": 2.0,
  "compare": "absolute",
  "compare_interval_sec": 900.0,
  "confirm_sec": 30.0,
  "settle_sec": 120.0,
  "safety_mvc": 40.0,

  "dry_run": true,
  "switch_ramp_sec": 300.0,
  "levels": {
    "low": {"dpi": 800, "sens": 1.0},
    "high": {"dpi": 1200, "sens": 1.5}
  },

  "host": "127.0.0.1",
  "port": 9000,
  "send_hz": 2.0,
  "duration": null,
  "report_sec": 10.0,
  "out_dir": "sessions",
  "subject_id": "",
  "launch_plugin": true,
  "stop_grace_sec": 8.0,

  "stream": {
    "name": "OpenSignals",
    "type": "",
    "hostname": "",
    "resolve_timeout": 10.0,
    "max_buflen": 3600,
    "recover": true
  },

  "signal": {
    "channel": 1,
    "adc_scale": 1.0,
    "adc_offset": 0.0,
    "unit_label": "mV",
    "highpass_hz": 20.0,
    "lowpass_hz": 450.0,
    "notch_hz": 50.0,
    "notch_q": 30.0,
    "filter_order": 4,
    "rms_window_sec": 0.125,
    "rms_hop_sec": 0.0625,
    "startup_skip_sec": 0.5
  }
}
